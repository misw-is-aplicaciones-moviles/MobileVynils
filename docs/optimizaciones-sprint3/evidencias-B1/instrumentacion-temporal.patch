+package co.edu.uniandes.vinilos.ui
+
+import android.os.Debug
+import android.os.SystemClock
+import android.util.Log
+
+/** Temporary measurement counters for the B1 block; not part of any commit. */
+@Suppress("DEPRECATION")
+object B1Perf {
+    private const val TAG = "B1PERF"
+
+    init {
+        Debug.startAllocCounting()
+    }
+
+    fun <T> measure(name: String, block: () -> T): T {
+        val count = Debug.getThreadAllocCount()
+        val size = Debug.getThreadAllocSize()
+        val start = SystemClock.elapsedRealtimeNanos()
+        val result = block()
+        val ns = SystemClock.elapsedRealtimeNanos() - start
+        Log.d(
+            TAG,
+            "$name ns=$ns allocs=${Debug.getThreadAllocCount() - count} bytes=${Debug.getThreadAllocSize() - size} " +
+                "gallocs=${Debug.getGlobalAllocCount()} gbytes=${Debug.getGlobalAllocSize()}",
+        )
+        return result
+    }
+
+    fun event(name: String) {
+        Log.d(TAG, "$name ns=0 allocs=0 bytes=0 gallocs=${Debug.getGlobalAllocCount()} gbytes=${Debug.getGlobalAllocSize()}")
+    }
+}
