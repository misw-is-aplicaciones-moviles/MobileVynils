# Gradle
.gradle/
build/
/captures/
.kotlin/

# Permitir versionar los APK de debug y release generados por Gradle
!/app/build/
/app/build/*
!/app/build/outputs/
/app/build/outputs/*
!/app/build/outputs/apk/
/app/build/outputs/apk/*
!/app/build/outputs/apk/debug/
/app/build/outputs/apk/debug/*
!/app/build/outputs/apk/debug/app-debug.apk
!/app/build/outputs/apk/release/
/app/build/outputs/apk/release/*
!/app/build/outputs/apk/release/app-release.apk

# Android Studio / IntelliJ
*.iml
.idea/
.cxx/
local.properties
*.hprof

# Firmas y secretos (la keystore de depuración del proyecto sí se versiona en keystore/)
*.jks
!keystore/debug.keystore
*.pem
.env

# Reportes y salidas
/app/release/
/app/debug/
reports/
lint-results*.html
lint-results*.xml

# Sistema
.DS_Store
Thumbs.db
