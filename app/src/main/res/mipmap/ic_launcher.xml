<?xml version="1.0" encoding="utf-8"?>
<!-- Icono para Android 6 y 7 (API 23 a 25), que no admiten iconos adaptativos:
     el mismo fondo y primer plano del icono adaptativo, recortados a círculo por el launcher. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
