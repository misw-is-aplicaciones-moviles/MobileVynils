<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de "Elegir músico": disco, nombre, sobrelínea y "YA INTEGRANTE" o el círculo de
     selección. Reutiliza el fondo y la línea de la fila de premios; un solo nodo accesible con la descripción del adaptador. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_prize_row" android:orientation="vertical"
    android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:minHeight="@dimen/prize_row_min_height"
        android:orientation="horizontal" android:paddingStart="@dimen/space_s" android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_s" android:clipChildren="false" android:clipToPadding="false">
        <include android:id="@+id/memberArtwork" layout="@layout/view_performer_artwork"
            android:layout_width="@dimen/band_member_artwork_size"
            android:layout_height="@dimen/band_member_artwork_size" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l" android:layout_marginEnd="@dimen/space_s"
            android:layout_weight="1" android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">
            <TextView android:id="@+id/musicianName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Vinilos.AlbumTitle" />
            <TextView android:id="@+id/musicianOverline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s"
                android:ellipsize="end" android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Vinilos.Overline" />
        </LinearLayout>
        <TextView android:id="@+id/alreadyMember" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/bg_prize_assigned"
            android:importantForAccessibility="no" android:paddingStart="@dimen/space_s"
            android:paddingTop="@dimen/space_xs" android:paddingEnd="@dimen/space_s"
            android:paddingBottom="@dimen/space_xs" android:text="@string/band_member_already"
            android:textAppearance="@style/TextAppearance.Vinilos.Overline" android:textColor="@color/vinilos_charcoal" />
        <ImageView android:id="@+id/musicianCheck" android:layout_width="@dimen/prize_check_size"
            android:layout_height="@dimen/prize_check_size" android:background="@drawable/bg_prize_check"
            android:importantForAccessibility="no" android:scaleType="center"
            app:srcCompat="@drawable/ic_prize_check_state" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="@dimen/space_s"
        android:background="@drawable/bg_prize_row_line" android:importantForAccessibility="no" />
</LinearLayout>
