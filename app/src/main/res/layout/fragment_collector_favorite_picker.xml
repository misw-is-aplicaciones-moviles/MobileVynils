<?xml version="1.0" encoding="utf-8"?>
<!-- Selector de artista favorito HU10 · Fase 1: cabecera carbón + hoja con búsqueda, lista y CTA. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/headerBar"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <co.edu.uniandes.vinilos.ui.common.PaperSheetLayout
        android:id="@+id/sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="@dimen/form_padding_horizontal">

            <EditText
                android:id="@+id/searchField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_track_field"
                android:drawableStart="@drawable/ic_prize_search"
                android:drawablePadding="@dimen/space_m"
                android:hint="@string/collector_favorite_picker_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/prize_search_vertical_padding"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/prize_search_vertical_padding"
                android:textAppearance="@style/TextAppearance.Vinilos.Body"
                android:textColorHint="@color/vinilos_graphite"
                tools:text="" />

            <TextView
                android:id="@+id/pickerContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Vinilos.Caption"
                tools:text="para Manolo Bellon" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/performerList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_collector_favorite_option" />

            <TextView
                android:id="@+id/emptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/space_xl"
                android:textAppearance="@style/TextAppearance.Vinilos.Body"
                android:visibility="gone"
                tools:text="Aún no hay artistas." />

            <include
                android:id="@+id/loadingState"
                layout="@layout/view_state_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/pickerStatus"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:visibility="gone">

                <include
                    android:id="@+id/errorState"
                    layout="@layout/view_state_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>
        </LinearLayout>
    </co.edu.uniandes.vinilos.ui.common.PaperSheetLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/prize_shadow_height"
        android:background="@drawable/bg_actions_shadow"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vinilos_cream"
        android:orientation="vertical"
        android:padding="@dimen/form_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/submitError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_m"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Vinilos.FieldError"
            android:visibility="gone"
            tools:text="No se pudo agregar el artista. Inténtalo de nuevo." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            style="@style/Widget.Vinilos.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="@dimen/button_height"
            android:text="@string/collector_favorite_picker_select" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
