<?xml version="1.0" encoding="utf-8"?>
<!-- Nuevo álbum: cabecera con X, hoja crema con el formulario
     y los botones fijos abajo. Cada etiqueta apunta a su campo con labelFor para TalkBack. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/headerBar"
        layout="@layout/view_header" />

    <co.edu.uniandes.vinilos.ui.common.PaperSheetLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/formScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/formContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/form_padding_horizontal"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingEnd="@dimen/form_padding_horizontal"
                    android:paddingBottom="@dimen/space_xl">

                    <TextView
                        android:id="@+id/requiredNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/create_album_all_required"
                        android:textAppearance="@style/TextAppearance.Vinilos.Caption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/form_section_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <co.edu.uniandes.vinilos.ui.common.VinylArtworkView
                            android:id="@+id/coverPreview"
                            android:layout_width="@dimen/album_catalog_artwork_width"
                            android:layout_height="@dimen/album_catalog_artwork_height"
                            android:clipChildren="false"
                            android:contentDescription="@string/create_album_cover_description"
                            app:artworkCornerRadius="@dimen/album_catalog_artwork_radius"
                            app:artworkElevation="@dimen/album_catalog_artwork_elevation"
                            app:artworkRatio="71:48"
                            app:coverSrc="@drawable/bg_cover_placeholder"
                            app:discScale="@dimen/album_disc_scale" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/form_preview_gap"
                            android:layout_weight="1"
                            android:text="@string/create_album_cover_hint"
                            android:textAppearance="@style/TextAppearance.Vinilos.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nameLabel"
                        style="@style/Widget.Vinilos.FieldLabel"
                        android:labelFor="@id/nameInput"
                        android:text="@string/field_name" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nameLayout"
                        style="@style/Widget.Vinilos.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nameInput"
                            style="@style/Widget.Vinilos.TextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_album_name"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/coverLabel"
                        style="@style/Widget.Vinilos.FieldLabel"
                        android:labelFor="@id/coverInput"
                        android:text="@string/field_cover_url" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/coverLayout"
                        style="@style/Widget.Vinilos.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/coverInput"
                            style="@style/Widget.Vinilos.TextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_cover_url"
                            android:imeOptions="actionNext"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/dateLabel"
                        style="@style/Widget.Vinilos.FieldLabel"
                        android:labelFor="@id/dateInput"
                        android:text="@string/field_release_date" />

                    <!-- Solo lectura: tocar el campo o el calendario abre el MaterialDatePicker. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dateLayout"
                        style="@style/Widget.Vinilos.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconContentDescription="@string/date_picker_title"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/dateInput"
                            style="@style/Widget.Vinilos.TextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="@string/hint_release_date"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/descriptionLabel"
                        style="@style/Widget.Vinilos.FieldLabel"
                        android:labelFor="@id/descriptionInput"
                        android:text="@string/field_description" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/descriptionLayout"
                        style="@style/Widget.Vinilos.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/descriptionInput"
                            style="@style/Widget.Vinilos.TextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:hint="@string/hint_description"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minHeight="@dimen/description_min_height" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/genreLabel"
                        style="@style/Widget.Vinilos.FieldLabel"
                        android:text="@string/field_genre" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/genreChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/chip_spacing"
                        app:singleSelection="true" />

                    <TextView
                        android:id="@+id/genreError"
                        style="@style/Widget.Vinilos.FieldError"
                        tools:text="@string/error_select_genre" />

                    <TextView
                        android:id="@+id/recordLabelLabel"
                        style="@style/Widget.Vinilos.FieldLabel"
                        android:text="@string/field_record_label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/recordLabelChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/chip_spacing"
                        app:singleSelection="true" />

                    <TextView
                        android:id="@+id/recordLabelError"
                        style="@style/Widget.Vinilos.FieldError"
                        tools:text="@string/error_select_label" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/form_padding_horizontal"
                android:paddingTop="@dimen/space_l"
                android:paddingEnd="@dimen/form_padding_horizontal"
                android:paddingBottom="@dimen/space_l">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/Widget.Vinilos.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/button_gap"
                    android:layout_weight="1"
                    android:text="@string/action_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createButton"
                    style="@style/Widget.Vinilos.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_create_album" />
            </LinearLayout>
        </LinearLayout>
    </co.edu.uniandes.vinilos.ui.common.PaperSheetLayout>
</LinearLayout>
