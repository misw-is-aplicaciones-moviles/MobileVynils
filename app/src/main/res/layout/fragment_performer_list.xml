<?xml version="1.0" encoding="utf-8"?>
<!-- Artistas (HU03): cabecera carbón y hoja crema con los filtros y la lista, o uno de los estados de carga, error y vacío. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/headerBar"
        layout="@layout/view_header" />

    <co.edu.uniandes.vinilos.ui.common.PaperSheetLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Los filtros siempre se ven: con un filtro sin resultados hay que poder volver a "Todos".
                 Los chips no guardan su estado: lo dibuja el ViewModel, también tras recrear la pantalla. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="@dimen/performer_filters_padding_start"
                android:paddingTop="@dimen/performer_filters_padding_top"
                android:paddingEnd="@dimen/performer_filters_padding_start"
                android:paddingBottom="@dimen/performer_filters_padding_bottom"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filterChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    app:chipSpacingHorizontal="@dimen/chip_spacing"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterAll"
                        style="@style/Widget.Vinilos.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:text="@string/filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterMusicians"
                        style="@style/Widget.Vinilos.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:text="@string/filter_musicians" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterBands"
                        style="@style/Widget.Vinilos.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:text="@string/filter_bands" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/performerList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/performer_list_bottom_padding"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_performer" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <View
                    android:id="@+id/listFade"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_fade_height"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_list_fade"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />

                <include
                    android:id="@+id/loadingState"
                    layout="@layout/view_state_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <include
                    android:id="@+id/errorState"
                    layout="@layout/view_state_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Vacío: también se puede deslizar para actualizar. -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/emptyRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <include
                                android:id="@+id/emptyState"
                                layout="@layout/view_state_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center" />
                        </FrameLayout>
                    </androidx.core.widget.NestedScrollView>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </FrameLayout>
        </LinearLayout>
    </co.edu.uniandes.vinilos.ui.common.PaperSheetLayout>
</LinearLayout>
