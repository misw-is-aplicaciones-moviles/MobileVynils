<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <include android:id="@+id/headerBar" layout="@layout/view_header"
        android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <co.edu.uniandes.vinilos.ui.common.PaperSheetLayout android:id="@+id/sheet"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar" app:layout_constraintBottom_toTopOf="@id/actions"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="@dimen/form_padding_horizontal">
            <EditText android:id="@+id/prizeSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height" android:background="@drawable/bg_track_field"
                android:padding="@dimen/space_l" android:drawableStart="@drawable/ic_prize_search"
                android:drawablePadding="@dimen/space_m" android:hint="@string/prize_search_hint"
                android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Vinilos.Body" />
            <TextView android:id="@+id/artistContext" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" android:layout_marginBottom="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.Vinilos.Caption" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/prizeList"
                    android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" />
                <include android:id="@+id/loadingState" layout="@layout/view_state_loading"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" />
                <include android:id="@+id/errorState" layout="@layout/view_state_error"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:visibility="gone" />
                <TextView android:id="@+id/emptyMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:gravity="center" android:padding="@dimen/space_l"
                    android:textAppearance="@style/TextAppearance.Vinilos.Body" android:visibility="gone" />
            </FrameLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/createPrize"
                style="@style/Widget.Vinilos.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/button_height"
                android:text="@string/prize_create_action" android:visibility="gone" />
            <TextView android:id="@+id/createHelp" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/prize_create_help" android:textAppearance="@style/TextAppearance.Vinilos.Caption"
                android:gravity="center" android:visibility="gone" />
        </LinearLayout>
    </co.edu.uniandes.vinilos.ui.common.PaperSheetLayout>
    <LinearLayout android:id="@+id/actions" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/vinilos_cream" android:padding="@dimen/form_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/continuePrize"
            style="@style/Widget.Vinilos.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/button_height"
            android:text="@string/prize_select_action" android:enabled="false" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
