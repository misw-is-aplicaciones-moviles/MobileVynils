<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja crema: pregunta, las dos tarjetas y la nota para cambiar de rol. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheetScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <co.edu.uniandes.vinilos.ui.common.PaperSheetLayout
        android:id="@+id/sheetSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/sheetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/role_card_margin_horizontal"
            android:paddingTop="@dimen/space_xxl"
            android:paddingEnd="@dimen/role_card_margin_horizontal"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/roleQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/role_question"
                android:textAppearance="@style/TextAppearance.Vinilos.RoleQuestion"
                tools:ignore="UnusedAttribute" />

            <include
                android:id="@+id/visitorCard"
                layout="@layout/item_role_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl" />

            <include
                android:id="@+id/collectorCard"
                layout="@layout/item_role_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l" />

            <TextView
                android:id="@+id/roleHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/role_change_hint"
                android:textAppearance="@style/TextAppearance.Vinilos.RoleHint" />
        </LinearLayout>
    </co.edu.uniandes.vinilos.ui.common.PaperSheetLayout>
</androidx.core.widget.NestedScrollView>
