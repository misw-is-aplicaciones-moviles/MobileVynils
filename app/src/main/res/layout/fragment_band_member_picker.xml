<?xml version="1.0" encoding="utf-8"?>
<!-- "Elegir músico": misma estructura que "Elegir premio", sin la tarjeta de crear y con el aviso
     de banda ocupada entre el contexto y la lista. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <include android:id="@+id/headerBar" layout="@layout/view_header"
        android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <co.edu.uniandes.vinilos.ui.common.PaperSheetLayout android:id="@+id/sheet"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar" app:layout_constraintBottom_toTopOf="@id/actions"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:clipToPadding="false" android:padding="@dimen/form_padding_horizontal">
            <EditText android:id="@+id/musicianSearch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/min_touch_target"
                android:background="@drawable/bg_track_field" android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/prize_search_vertical_padding" android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/prize_search_vertical_padding"
                android:drawableStart="@drawable/ic_prize_search" android:drawablePadding="@dimen/space_m"
                android:hint="@string/band_member_search_hint" android:importantForAutofill="no"
                android:inputType="textPersonName" android:imeOptions="actionSearch" android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Vinilos.Body"
                android:textColorHint="@color/vinilos_graphite" />
            <TextView android:id="@+id/bandContext" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Vinilos.Caption" />
            <co.edu.uniandes.vinilos.ui.common.NoticeView android:id="@+id/memberNotice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" android:layout_marginBottom="@dimen/space_m"
                android:drawableStart="@drawable/ic_warning" android:drawablePadding="@dimen/space_m"
                android:visibility="gone" app:noticeKind="error" />
            <!-- El bloque sobresale 8 dp para el fondo de la fila elegida, como en "Elegir premio". -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginStart="@dimen/prize_list_overhang"
                android:layout_marginEnd="@dimen/prize_list_overhang" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/musicianList"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clipToPadding="false" />
                <TextView android:id="@+id/emptyMessage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/space_l"
                    android:textAppearance="@style/TextAppearance.Vinilos.Body" android:visibility="gone" />
                <include android:id="@+id/loadingState" layout="@layout/view_state_loading"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" />
                <include android:id="@+id/errorState" layout="@layout/view_state_error"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </co.edu.uniandes.vinilos.ui.common.PaperSheetLayout>
    <View android:layout_width="0dp" android:layout_height="@dimen/prize_shadow_height"
        android:background="@drawable/bg_actions_shadow" android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/actions" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <LinearLayout android:id="@+id/actions" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/vinilos_cream"
        android:padding="@dimen/form_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/addMember"
            style="@style/Widget.Vinilos.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/button_height"
            android:text="@string/band_member_select_action" android:enabled="false" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
