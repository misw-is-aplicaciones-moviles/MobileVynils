<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor de navegación y barra inferior del kit v2 (TR-01, docs/05 sección 3).
     El botón "+" (HU01) sobresale de la barra: ningún contenedor recorta a sus hijos. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <!-- La barra recibe el margen de la navegación del sistema en este contenedor (MainActivity). -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vinilos_cream"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.Vinilos.BottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav"
            app:paddingBottomSystemWindowInsets="false" />

        <View
            android:id="@+id/navDot"
            android:layout_width="@dimen/nav_dot_size"
            android:layout_height="@dimen/nav_dot_size"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_nav_dot"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Hermano de la barra y no hijo: un hijo fuera de los límites de su padre no recibe toques. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/primaryAction"
        style="@style/Widget.Vinilos.FloatingActionButton"
        android:contentDescription="@string/action_create_album"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationY="@dimen/primary_action_drop"
        android:visibility="gone"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_add"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
