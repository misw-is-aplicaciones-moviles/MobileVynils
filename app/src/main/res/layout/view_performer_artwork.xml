<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_performer_disc" android:elevation="@dimen/performer_disc_elevation"
    android:importantForAccessibility="noHideDescendants">
    <ImageView android:layout_width="0dp" android:layout_height="0dp"
        android:importantForAccessibility="no" app:srcCompat="@drawable/img_vinyl_disc"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/performerImage"
        android:layout_width="0dp" android:layout_height="0dp" android:scaleType="centerCrop"
        android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/ShapeAppearance.Vinilos.Circle"
        app:layout_constraintWidth_percent="0.5" app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/bg_performer_image_placeholder" />
</androidx.constraintlayout.widget.ConstraintLayout>
