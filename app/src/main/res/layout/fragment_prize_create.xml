<?xml version="1.0" encoding="utf-8"?>
<!-- Nuevo premio (HU13): cabecera con X, hoja crema con tres campos obligatorios y franja de botones fija abajo.
     Cada etiqueta apunta a su campo con labelFor para TalkBack. El error va en su propia vista porque el del
     TextInputLayout queda sangrado y los mockups lo alinean con el borde del campo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/headerBar"
        layout="@layout/view_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <co.edu.uniandes.vinilos.ui.common.PaperSheetLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/formContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/form_padding_horizontal"
                android:paddingTop="@dimen/space_xl"
                android:paddingEnd="@dimen/form_padding_horizontal"
                android:paddingBottom="@dimen/space_xl">

                <TextView
                    android:id="@+id/requiredNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_prize_all_required"
                    android:textAppearance="@style/TextAppearance.Vinilos.Caption" />

                <TextView
                    android:id="@+id/prizeNameLabel"
                    style="@style/Widget.Vinilos.FieldLabel"
                    android:labelFor="@id/prizeNameInput"
                    android:text="@string/field_name"
                    android:textColor="@color/vinilos_graphite" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/prizeNameLayout"
                    style="@style/Widget.Vinilos.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/prizeNameInput"
                        style="@style/Widget.Vinilos.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_prize_name"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:textColorHint="@color/vinilos_graphite" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/prizeNameError"
                    style="@style/Widget.Vinilos.FieldError"
                    android:layout_marginTop="@dimen/space_s"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <TextView
                    android:id="@+id/prizeDescriptionLabel"
                    style="@style/Widget.Vinilos.FieldLabel"
                    android:labelFor="@id/prizeDescriptionInput"
                    android:text="@string/field_description"
                    android:textColor="@color/vinilos_graphite" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/prizeDescriptionLayout"
                    style="@style/Widget.Vinilos.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/prizeDescriptionInput"
                        style="@style/Widget.Vinilos.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/hint_prize_description"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minHeight="@dimen/description_min_height"
                        android:textColorHint="@color/vinilos_graphite" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/prizeDescriptionError"
                    style="@style/Widget.Vinilos.FieldError"
                    android:layout_marginTop="@dimen/space_s"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <TextView
                    android:id="@+id/prizeOrganizationLabel"
                    style="@style/Widget.Vinilos.FieldLabel"
                    android:labelFor="@id/prizeOrganizationInput"
                    android:text="@string/field_organization"
                    android:textColor="@color/vinilos_graphite" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/prizeOrganizationLayout"
                    style="@style/Widget.Vinilos.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/prizeOrganizationInput"
                        style="@style/Widget.Vinilos.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_prize_organization"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:textColorHint="@color/vinilos_graphite" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/prizeOrganizationError"
                    style="@style/Widget.Vinilos.FieldError"
                    android:layout_marginTop="@dimen/space_s"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </co.edu.uniandes.vinilos.ui.common.PaperSheetLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/prize_shadow_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_actions_shadow"
        android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vinilos_cream"
        android:orientation="vertical"
        android:paddingStart="@dimen/form_padding_horizontal"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/form_padding_horizontal"
        android:paddingBottom="@dimen/space_l">

        <!-- Resultado de un envío o de una comprobación. Oculto hasta que haya algo que decir. -->
        <TextView
            android:id="@+id/formNotice"
            style="@style/Widget.Vinilos.FieldError"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="@dimen/space_m"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            tools:text="@string/create_prize_uncertain"
            tools:visibility="visible" />

        <!-- Sin alinear líneas base: con fuente grande, "Crear premio" ocupa dos líneas y bajaría hasta cortarse. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelPrizeButton"
                style="@style/Widget.Vinilos.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/button_gap"
                android:layout_weight="1"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createPrizeButton"
                style="@style/Widget.Vinilos.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/action_create_prize" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
