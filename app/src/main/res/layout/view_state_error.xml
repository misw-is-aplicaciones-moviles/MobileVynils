<?xml version="1.0" encoding="utf-8"?>
<!-- Estado de error compartido (kit v2): anillos con alerta, título, cuerpo y "Reintentar".
     Cada pantalla cambia los textos por defecto desde su Fragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/state_padding_horizontal"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/state_padding_horizontal"
    android:paddingBottom="@dimen/space_xl">

    <ImageView
        android:layout_width="@dimen/state_illustration_size"
        android:layout_height="@dimen/state_illustration_size"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_state_error_rings" />

    <TextView
        android:id="@+id/errorTitle"
        android:includeFontPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/state_title_gap"
        android:gravity="center"
        android:text="@string/state_error_title"
        android:textAppearance="@style/TextAppearance.Vinilos.StateTitle" />

    <TextView
        android:id="@+id/errorBody"
        android:includeFontPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/state_body_gap"
        android:gravity="center"
        android:text="@string/state_error_body"
        android:textAppearance="@style/TextAppearance.Vinilos.StateBody" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        style="@style/Widget.Vinilos.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/state_button_gap"
        android:minWidth="@dimen/state_button_min_width"
        android:text="@string/action_retry" />
</LinearLayout>
