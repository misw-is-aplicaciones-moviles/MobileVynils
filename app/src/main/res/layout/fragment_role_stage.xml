<?xml version="1.0" encoding="utf-8"?>
<!-- Zona carbón: marca VINILOS y el collage de disco y carátula. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/role_brand_margin_start"
    android:paddingEnd="@dimen/role_brand_margin_start"
    android:paddingBottom="@dimen/space_xxl">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/role_brand_icon"
            android:layout_height="@dimen/role_brand_icon"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_brand_disc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/role_title"
            android:textAppearance="@style/TextAppearance.Vinilos.Wordmark" />
    </LinearLayout>

    <co.edu.uniandes.vinilos.ui.common.VinylArtworkView
        android:id="@+id/roleArtwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxl"
        android:importantForAccessibility="no" />
</LinearLayout>
