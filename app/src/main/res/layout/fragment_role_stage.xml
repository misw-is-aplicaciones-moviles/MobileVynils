<?xml version="1.0" encoding="utf-8"?>
<!-- Zona carbón: marca VINILOS y el collage de disco y carátula. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/role_brand_margin_start"
    android:paddingEnd="@dimen/role_brand_margin_start"
    android:paddingBottom="@dimen/space_xxl">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/role_brand_icon"
            android:layout_height="@dimen/role_brand_icon"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_brand_disc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/role_title"
            android:textAppearance="@style/TextAppearance.Vinilos.Wordmark" />
    </LinearLayout>

    <!-- El marco 33:20 deja el disco asomado detrás de la carátula, como en el mockup. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxl"
        android:importantForAccessibility="no">

        <View
            android:id="@+id/heroFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintDimensionRatio="33:20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/heroDisc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@id/heroFrame"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@id/heroFrame"
            app:layout_constraintTop_toTopOf="@id/heroFrame"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Vinilos.Circle"
            app:srcCompat="@drawable/bg_vinyl_disc" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:cardBackgroundColor="@color/vinilos_charcoal"
            app:cardCornerRadius="@dimen/role_cover_radius"
            app:cardElevation="@dimen/role_cover_elevation"
            app:layout_constraintBottom_toBottomOf="@id/heroFrame"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="@id/heroFrame"
            app:layout_constraintTop_toTopOf="@id/heroFrame"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/bg_album_cover" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
