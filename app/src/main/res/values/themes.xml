<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema claro del kit v2 sobre Material Components (docs/05, sección 1). -->
    <style name="Base.Theme.Vinilos" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/vinilos_charcoal</item>
        <item name="colorOnPrimary">@color/vinilos_cream</item>
        <item name="colorSecondary">@color/vinilos_graphite</item>
        <item name="colorOnSecondary">@color/vinilos_cream</item>
        <item name="colorSurface">@color/vinilos_cream</item>
        <item name="colorOnSurface">@color/vinilos_charcoal</item>
        <item name="colorOnSurfaceVariant">@color/vinilos_graphite</item>
        <item name="colorOutline">@color/vinilos_ash</item>
        <item name="colorOutlineVariant">@color/vinilos_line</item>
        <item name="android:colorBackground">@color/vinilos_cream</item>
        <!-- Detrás de la hoja crema se ve el carbón de la cabecera. -->
        <item name="android:windowBackground">@color/vinilos_charcoal</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="fontFamily">@font/outfit_regular</item>
        <item name="materialButtonStyle">@style/Widget.Vinilos.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Vinilos.Button.Secondary</item>
    </style>

    <style name="Theme.Vinilos" parent="Base.Theme.Vinilos" />

    <!-- Título de la cabecera: Outfit 400, 19/24 sp, crema sobre carbón. -->
    <style name="TextAppearance.Vinilos.HeaderTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="fontFamily">@font/outfit_regular</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/vinilos_cream</item>
    </style>

    <!-- Cuerpo: Outfit 400, 15 sp, grafito. -->
    <style name="TextAppearance.Vinilos.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="fontFamily">@font/outfit_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/vinilos_graphite</item>
    </style>

    <!-- Etiquetas de la barra inferior: Montserrat 10 sp en mayúsculas, espaciado 1 sp. -->
    <style name="TextAppearance.Vinilos.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Vinilos.NavLabel.Active">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="fontFamily">@font/montserrat_bold</item>
    </style>

    <!-- Barra inferior del kit v2: fondo crema, sin indicador de pastilla, etiquetas siempre visibles. -->
    <style name="Widget.Vinilos.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/vinilos_cream</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Vinilos.NavLabel</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Vinilos.NavLabel.Active</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Vinilos.BottomNavigationView.NoIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Vinilos.BottomNavigationView.NoIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Marca del selector: Montserrat 800, 14 sp, tracking amplio, crema sobre carbón. -->
    <style name="TextAppearance.Vinilos.Wordmark" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/montserrat_extrabold</item>
        <item name="fontFamily">@font/montserrat_extrabold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.32</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
        <item name="android:textColor">@color/vinilos_cream</item>
    </style>

    <!-- Pregunta del selector: Outfit 300, 28/35 sp. -->
    <style name="TextAppearance.Vinilos.RoleQuestion" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/outfit_light</item>
        <item name="fontFamily">@font/outfit_light</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/vinilos_charcoal</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- Nombre del rol: Montserrat 800, 14 sp, mayúsculas, tracking corto. -->
    <style name="TextAppearance.Vinilos.RoleLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/montserrat_extrabold</item>
        <item name="fontFamily">@font/montserrat_extrabold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
        <item name="android:textColor">@color/vinilos_charcoal</item>
    </style>

    <!-- Descripción de la tarjeta: Outfit 400, 14/20 sp. -->
    <style name="TextAppearance.Vinilos.RoleDescription" parent="TextAppearance.Vinilos.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.43</item>
    </style>

    <!-- Nota al pie del selector: Outfit 400, 13 sp. -->
    <style name="TextAppearance.Vinilos.RoleHint" parent="TextAppearance.Vinilos.Body">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ShapeAppearance.Vinilos.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Título de una fila: Outfit 400, 16 sp, carbón. -->
    <style name="TextAppearance.Vinilos.ListTitle" parent="TextAppearance.Vinilos.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/vinilos_charcoal</item>
    </style>

    <!-- Tercera línea de la fila: Outfit 400, 13 sp. -->
    <style name="TextAppearance.Vinilos.ListMeta" parent="TextAppearance.Vinilos.Body">
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Chip de rol: Montserrat 700, 9.5 sp, tracking 1.14 px (0.12 em), crema. -->
    <style name="TextAppearance.Vinilos.RoleChip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">9.5sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
        <item name="android:textColor">@color/vinilos_cream</item>
    </style>

    <!-- Píldora de 32 dp con radio completo. El toque sigue en 48 dp, fuera del trazo. -->
    <style name="ShapeAppearance.Vinilos.RoleChip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/role_chip_radius</item>
    </style>

    <style name="Widget.Vinilos.Chip.Role" parent="Widget.Material3.Chip.Assist">
        <item name="android:checkable">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Vinilos.RoleChip</item>
        <item name="android:textColor">@color/vinilos_cream</item>
        <item name="android:includeFontPadding">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Vinilos.RoleChip</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <!-- El fondo por defecto es colorSurface (crema) y tapa el texto crema. -->
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@color/vinilos_cream_border</item>
        <item name="chipStrokeWidth">@dimen/role_chip_stroke</item>
        <item name="chipIconTint">@color/vinilos_cream</item>
        <item name="chipIconSize">@dimen/role_chip_icon</item>
        <item name="chipMinHeight">@dimen/role_chip_height</item>
        <item name="chipStartPadding">@dimen/role_chip_padding_start</item>
        <item name="iconStartPadding">0dp</item>
        <item name="iconEndPadding">@dimen/role_chip_icon_gap</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="chipEndPadding">@dimen/role_chip_padding_end</item>
        <item name="chipMinTouchTargetSize">@dimen/min_touch_target</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- Aviso: Outfit 400, 15 sp. El color lo pone el tipo de aviso. -->
    <style name="TextAppearance.Vinilos.Notice" parent="TextAppearance.Vinilos.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Etiqueta de botón: Outfit 400, 15 sp. El color lo pone cada variante. -->
    <style name="TextAppearance.Vinilos.Button" parent="TextAppearance.Vinilos.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ShapeAppearance.Vinilos.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/button_radius</item>
    </style>

    <!-- Píldora de 52 dp. El alto ya cubre el mínimo táctil, sin el inset de Material. -->
    <style name="Widget.Vinilos.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">@dimen/button_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/button_padding_horizontal</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Vinilos.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Vinilos.Button</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="strokeWidth">@dimen/button_stroke</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Relleno carbón. Deshabilitado: piedra, igual que el secundario. -->
    <style name="Widget.Vinilos.Button.Primary" parent="Widget.Vinilos.Button">
        <item name="backgroundTint">@color/button_filled</item>
        <item name="strokeColor">@color/button_filled</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="iconTint">@color/button_primary_text</item>
        <item name="rippleColor">@color/vinilos_cream_ripple</item>
    </style>

    <!-- Solo borde carbón. Deshabilitado: el mismo relleno piedra. -->
    <style name="Widget.Vinilos.Button.Secondary" parent="Widget.Vinilos.Button">
        <item name="backgroundTint">@color/button_secondary_background</item>
        <item name="strokeColor">@color/button_filled</item>
        <item name="android:textColor">@color/vinilos_charcoal</item>
        <item name="iconTint">@color/vinilos_charcoal</item>
        <item name="rippleColor">@color/vinilos_charcoal_ripple</item>
    </style>
</resources>
