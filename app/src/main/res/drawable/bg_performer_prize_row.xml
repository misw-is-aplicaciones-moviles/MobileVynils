<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del detalle del artista (mockup HU14-6): la recién agregada se resalta con state_activated, que TalkBack
     no anuncia (H04-1). state_selected queda para la opción elegida en el selector de HU15. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vinilos_prize_selected" />
            <corners android:radius="@dimen/prize_row_radius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vinilos_prize_selected" />
            <corners android:radius="@dimen/prize_row_radius" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
