<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del selector de premios (mockups HU14-1 y HU13-4): sin relleno; piedra al elegirla. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vinilos_charcoal_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/vinilos_prize_selected" />
                    <corners android:radius="@dimen/prize_row_radius" />
                </shape>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/vinilos_cream" />
            <corners android:radius="@dimen/prize_row_radius" />
        </shape>
    </item>
</ripple>
