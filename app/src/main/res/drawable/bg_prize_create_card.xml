<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta "Crear un premio nuevo" del selector: borde carbón discontinuo sobre la hoja, con ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vinilos_charcoal_ripple">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/prize_create_card_stroke"
                android:color="@color/vinilos_charcoal"
                android:dashWidth="@dimen/prize_create_card_dash"
                android:dashGap="@dimen/prize_create_card_dash_gap" />
            <corners android:radius="@dimen/prize_create_card_radius" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/vinilos_cream" />
            <corners android:radius="@dimen/prize_create_card_radius" />
        </shape>
    </item>
</ripple>
