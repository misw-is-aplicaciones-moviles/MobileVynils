<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de precio: píldora oscura con borde punteado. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vinilos_charcoal" />
    <stroke
        android:width="1dp"
        android:color="@color/vinilos_ash"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="@dimen/track_field_radius" />
</shape>
