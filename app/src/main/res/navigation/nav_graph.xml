<?xml version="1.0" encoding="utf-8"?>
<!-- Destinos de primer nivel (docs/10, sección 3). El selector de rol es el inicio (TR-06).
     Cada historia reemplaza su pantalla provisional:
     HU01 ya reemplazó albumListFragment; HU03 performerListFragment y HU05 collectorListFragment siguen pendientes. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/roleSelectFragment">

    <fragment
        android:id="@+id/roleSelectFragment"
        android:name="co.edu.uniandes.vinilos.ui.role.RoleSelectFragment"
        android:label="@string/role_question">
        <action
            android:id="@+id/action_roleSelect_to_albumList"
            app:destination="@id/albumListFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/roleSelectFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/albumListFragment"
        android:name="co.edu.uniandes.vinilos.ui.albums.AlbumListFragment"
        android:label="@string/album_list_title">
        <action
            android:id="@+id/action_albumList_to_albumCreate"
            app:destination="@id/albumCreateFragment"
            app:launchSingleTop="true" />
    </fragment>

    <!-- HU07: pantalla completa sobre el catálogo, sin barra inferior (MainActivity). -->
    <fragment
        android:id="@+id/albumCreateFragment"
        android:name="co.edu.uniandes.vinilos.ui.albums.AlbumCreateFragment"
        android:label="@string/create_album_title" />

    <fragment
        android:id="@+id/performerListFragment"
        android:name="co.edu.uniandes.vinilos.ui.common.PendingTabFragment"
        android:label="@string/artist_list_title">
        <argument
            android:name="titleRes"
            android:defaultValue="@string/artist_list_title"
            app:argType="reference" />
        <argument
            android:name="messageRes"
            android:defaultValue="@string/pending_next_sprint"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/collectorListFragment"
        android:name="co.edu.uniandes.vinilos.ui.common.PendingTabFragment"
        android:label="@string/collector_list_title">
        <argument
            android:name="titleRes"
            android:defaultValue="@string/collector_list_title"
            app:argType="reference" />
        <argument
            android:name="messageRes"
            android:defaultValue="@string/pending_next_sprint"
            app:argType="reference" />
    </fragment>
</navigation>
