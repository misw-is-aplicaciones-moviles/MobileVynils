<?xml version="1.0" encoding="utf-8"?>
<!-- Destinos de primer nivel (docs/10, sección 3). El selector de rol es el inicio (TR-06).
     Cada historia reemplaza su pantalla provisional:
     HU01 ya reemplazó albumListFragment y HU03 performerListFragment; HU04 ya implementa performerDetailFragment; collectorListFragment ya tiene su lista y collectorDetailFragment sigue pendiente. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/roleSelectFragment">

    <fragment
        android:id="@+id/roleSelectFragment"
        android:name="co.edu.uniandes.vinilos.ui.role.RoleSelectFragment"
        android:label="@string/role_question">
        <action
            android:id="@+id/action_roleSelect_to_albumList"
            app:destination="@id/albumListFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/roleSelectFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/albumListFragment"
        android:name="co.edu.uniandes.vinilos.ui.albums.AlbumListFragment"
        android:label="@string/album_list_title">
        <action
            android:id="@+id/action_albumList_to_albumDetail"
            app:destination="@id/albumDetailFragment" />
        <action
            android:id="@+id/action_albumList_to_albumCreate"
            app:destination="@id/albumCreateFragment"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/albumDetailFragment"
        android:name="co.edu.uniandes.vinilos.ui.albums.AlbumDetailFragment"
        android:label="@string/album_detail_title">
        <argument android:name="albumId" app:argType="integer" />
    </fragment>
    <!-- Formulario de nuevo álbum: pantalla completa sobre el catálogo, sin barra inferior (MainActivity). -->
    <fragment
        android:id="@+id/albumCreateFragment"
        android:name="co.edu.uniandes.vinilos.ui.albums.AlbumCreateFragment"
        android:label="@string/create_album_title" />

    <fragment
        android:id="@+id/prizePickerFragment"
        android:name="co.edu.uniandes.vinilos.ui.artists.PrizePickerFragment"
        android:label="@string/prize_picker_title">
        <argument android:name="performerId" app:argType="integer" />
        <argument android:name="performerType" app:argType="string" />
        <argument android:name="performerName" app:argType="string" />
        <argument android:name="assignmentIds" app:argType="integer[]" />
    </fragment>

    <fragment
        android:id="@+id/performerListFragment"
        android:name="co.edu.uniandes.vinilos.ui.artists.PerformerListFragment"
        android:label="@string/artist_list_title">
        <action
            android:id="@+id/action_performerList_to_performerDetail"
            app:destination="@id/performerDetailFragment" />
    </fragment>

    <!-- Detalle de músico o banda (HU04); conserva los argumentos compartidos con HU03. -->
    <fragment
        android:id="@+id/performerDetailFragment"
        android:name="co.edu.uniandes.vinilos.ui.artists.PerformerDetailFragment"
        android:label="@string/artist_detail_title">
        <argument android:name="performerId" app:argType="integer" />
        <argument android:name="type" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/collectorListFragment"
        android:name="co.edu.uniandes.vinilos.ui.collectors.CollectorListFragment"
        android:label="@string/collector_list_title">
        <action
            android:id="@+id/action_collectorList_to_collectorDetail"
            app:destination="@id/collectorDetailFragment" />
    </fragment>

    <!-- Detalle de coleccionista. Hasta que llegue su historia es la pantalla provisional: esa historia solo cambia la clase.
         El argumento es el de docs/10 (sección 3); la provisional solo lee titleRes y messageRes. -->
    <fragment
        android:id="@+id/collectorDetailFragment"
        android:name="co.edu.uniandes.vinilos.ui.common.PendingTabFragment"
        android:label="@string/collector_detail_title">
        <argument
            android:name="collectorId"
            app:argType="integer" />
        <argument
            android:name="titleRes"
            android:defaultValue="@string/collector_detail_title"
            app:argType="reference" />
        <argument
            android:name="messageRes"
            android:defaultValue="@string/pending_next_sprint"
            app:argType="reference" />
    </fragment>
</navigation>
